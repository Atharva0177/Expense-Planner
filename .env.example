# GEMINI_API_KEY: Required for Gemini AI API calls (Receipt Scanner).
# Also used by the n8n Telegram bot for receipt photo scanning.
# AI Studio automatically injects this at runtime from user secrets.
# On Cloudflare Pages or Vercel, add this in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional client-side fallback key for static-only hosting deployments without serverless functions
VITE_GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Telegram Bot: the bot is now powered by n8n (see n8n/README.md).
# 1. Create bot: message @BotFather on Telegram -> /newbot
# 2. Paste the token into n8n as a "Telegram API" credential
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"

# n8n (Telegram bot automation) - only needed for the n8n profile:
#   docker compose --profile n8n up -d
# Generate with:  openssl rand -base64 32
N8N_ENCRYPTION_KEY="replace_with_openssl_rand_base64_32_output"

# Public HTTPS URL that reaches the n8n instance.
# With the default ngrok setup: your free static domain from
# https://dashboard.ngrok.com/domains, e.g. https://fox-robust-owl.ngrok-free.app
# (Alternatively, with a registered domain + Cloudflare Tunnel: https://n8n.your-domain.com)
N8N_WEBHOOK_URL="https://your-static-domain.ngrok-free.app"

# ngrok (default public-exposure setup) - https://dashboard.ngrok.com
# Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN="your_ngrok_authtoken"
# Free permanent static domain: https://dashboard.ngrok.com/domains
NGROK_DOMAIN="your-static-domain.ngrok-free.app"

# Alternative: Cloudflare Tunnel (requires a registered domain on Cloudflare)
# CLOUDFLARED_TUNNEL_TOKEN="your_cloudflare_tunnel_token"
